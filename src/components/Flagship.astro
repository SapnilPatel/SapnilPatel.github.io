---
// Flagship case-study card — notebook style. Recruiter-scannable up top
// (one-liner + metric tiles), depth below (approach, architecture sketch).
// On xl screens the card is a subgrid item spanning 8 rows, so paired cards
// align section-by-section regardless of content length.
interface Props {
  f: {
    tag: string;
    name: string;
    repo: string;
    oneLiner: string;
    problem: string;
    approach: string[];
    metrics: { value: string; label: string }[];
    architecture: string;
    stack: string[];
    note: string;
    writeup?: string; // link to the published deep-dive, once it exists
  };
}
const { f } = Astro.props;
---

<article class="card overflow-hidden transition hover:-translate-y-0.5 hover:shadow-[0_2px_4px_rgb(46_40_32/0.05),0_16px_36px_-20px_rgb(46_40_32/0.28)] xl:row-span-8 xl:grid xl:grid-rows-subgrid">
  <div class="flex items-start justify-between gap-3 border-b border-line px-6 py-4">
    <div class="min-w-0">
      <span class="inline-block rounded-full bg-accent-soft px-2.5 py-0.5 font-mono text-[11px] font-medium text-accent-deep">{f.tag}</span>
      <h3 class="mt-1.5 font-serif text-xl font-semibold text-ink2">{f.name}</h3>
    </div>
    <div class="mt-0.5 flex shrink-0 flex-col items-end gap-1.5">
      <a
        href={f.repo}
        target="_blank"
        rel="noreferrer"
        class="rounded-md border border-line-2 px-3 py-1 font-mono text-xs text-mute transition hover:border-accent hover:text-accent"
      >view code ↗</a>
      {f.writeup && (
        <a
          href={f.writeup}
          target="_blank"
          rel="noreferrer"
          class="rounded-md border border-line-2 px-3 py-1 font-mono text-xs text-mute transition hover:border-accent hover:text-accent"
        >write-up ↗</a>
      )}
    </div>
  </div>

  <p class="px-6 pt-5 text-[15px] leading-relaxed text-ink2">{f.oneLiner}</p>

  <!-- metric callouts — the recruiter row -->
  <div class="mt-5 grid grid-cols-3 gap-2 px-6 sm:gap-3">
    {f.metrics.map((m) => (
      <div class="rounded-lg border border-line bg-paper px-1.5 py-3 text-center sm:px-3">
        <p class="font-serif text-lg font-bold whitespace-nowrap text-accent sm:text-xl md:text-2xl">{m.value}</p>
        <p class="mt-1 text-[11px] leading-snug text-mute">{m.label}</p>
      </div>
    ))}
  </div>

  <p class="mt-5 px-6 text-sm leading-relaxed text-mute">
    <span class="font-semibold text-ink2">The problem. </span>{f.problem}
  </p>

  <ul class="mt-4 flex flex-col gap-1.5 px-6">
    {f.approach.map((a) => (
      <li class="text-sm leading-relaxed text-mute">
        <span class="mr-2 font-mono text-accent">▸</span>{a}
      </li>
    ))}
  </ul>

  <div class="mx-6 mt-5 self-start overflow-x-auto rounded-lg border border-line bg-paper px-4 py-3">
    <p class="label mb-2">architecture sketch</p>
    <pre class="font-mono text-[11px] leading-relaxed text-mute">{f.architecture}</pre>
  </div>

  <div class="mt-4 flex flex-wrap content-start gap-2 px-6">
    {f.stack.map((s) => (
      <span class="rounded-full border border-line bg-paper px-2.5 py-0.5 font-mono text-[11px] text-mute">{s}</span>
    ))}
  </div>

  <p class="mx-6 mt-4 self-end border-t border-line pt-3 pb-5 font-serif text-[15px] italic leading-relaxed text-mute">
    <span class="mark not-italic">Field note:</span> {f.note}
  </p>
</article>
