---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.title}`,
  description = profile.tagline,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content="https://sapnilpatel.github.io/sapnil.jpg" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="https://sapnilpatel.github.io/sapnil.jpg" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.name,
        jobTitle: profile.title,
        url: 'https://sapnilpatel.github.io',
        sameAs: [profile.github, profile.linkedin, profile.medium],
        address: { '@type': 'PostalAddress', addressLocality: profile.location },
        alumniOf: 'University of Southern California',
      })}
    />
  </head>
  <body class="min-h-screen">
    <slot />
    <!-- GoatCounter analytics (privacy-friendly, no cookies). Live once the
         'sapnilpatel' code is claimed at goatcounter.com — see README. -->
    <script
      data-goatcounter="https://sapnilpatel.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    ></script>
    <script>
      // reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.08 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
